import json
import requests
import time

BACKEND_URL = "https://smart-cart-backend-ewts.onrender.com/update-cart"

while True:

    try:

        with open("detections.json", "r") as f:
            data = json.load(f)

        detected_items = data.get("detected_items", [])

        payload = {
            "user_id": "u1",
            "items": detected_items          # send the full list every cycle
        }

        response = requests.post(BACKEND_URL, json=payload)

        result = response.json()

        print("Cart synced:", result.get("cart"))
        print("Detected:", result.get("synced_items"))

    except Exception as e:
        print("Error:", e)

    time.sleep(2)